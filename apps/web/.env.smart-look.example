# Film Lab スマートルック BFF — コピーして `.env.local` に置く（Git に含めない）
# Desktop が主戦場でも、LLM キーはここ＝サーバー側のみ。クライアント（Desktop .env）には書かない。

# 寄付 Cookie 検証（必須）
FILM_LAB_DONATION_SIGNING_SECRET=replace_with_your_signing_secret

# mock = デルタ固定（配線確認） / openai = Vision 経路（互換ベース＋モデルで OpenRouter 可）
FILM_LAB_SMART_LOOK_PROVIDER=openai

# OpenRouter（例）— 実キーは .env.local のみ
FILM_LAB_SMART_LOOK_OPENAI_COMPAT_BASE=https://openrouter.ai/api/v1
FILM_LAB_SMART_LOOK_OPENAI_COMPAT_API_KEY=replace_with_openrouter_secret_in_env_local_only
FILM_LAB_SMART_LOOK_CHAT_MODEL=openai/gpt-4o-mini

# OpenRouter 推奨の任意メタ（"dev" ではなく製品識別用）
FILM_LAB_SMART_LOOK_HTTP_REFERER=https://your-site-or-local-placeholder.example
FILM_LAB_SMART_LOOK_APP_TITLE=film-lab-smart-look-desktop-bff

# モデルが json_object 非対応のときだけ false
# FILM_LAB_SMART_LOOK_CHAT_JSON_MODE=false

# Electron + local Next: Cookie を跨げない開発向け（NODE_ENV=development のときのみ有効。.env.local のみで運用）
# FILM_LAB_SMART_LOOK_ALLOW_DESKTOP_DEV=true
