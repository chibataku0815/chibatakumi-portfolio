# =============================================================================
# Environment Variables - Contact Form
# =============================================================================

# Slack Webhook URL for contact form notifications
#
# Setup instructions:
# 1. Go to https://api.slack.com/apps
# 2. Create a new app or select an existing one
# 3. Navigate to "Incoming Webhooks" and activate them
# 4. Add a new webhook to your desired workspace/channel
# 5. Copy the webhook URL and paste it below
#
# Format: https://hooks.slack.com/services/TXXXXX/BXXXXX/XXXXXXXX
SLACK_WEBHOOK_URL=

# Meta Pixel ID for paid social attribution
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Film Lab: show "Share" block (copy look URL, post to X). Default off for general users.
# NEXT_PUBLIC_FILM_LAB_SHARE_UI=true

# Film Lab: optional support (Stripe Payment Link per amount tier + optional Buy Me a Coffee).
# If every Stripe URL below is empty AND BMC is empty, donation UI is hidden.
# Use separate Payment Links per price (do not put multiple line_items on one link).
# Set NEXT_PUBLIC_FILM_LAB_DONATION_UI=false to force-disable even when URLs are set.
NEXT_PUBLIC_FILM_LAB_DONATION_UI=true
# Live Payment Link (USD $3 one-time) — public URL; copy to .env.local if needed
NEXT_PUBLIC_FILM_LAB_STRIPE_SUPPORT_URL=https://buy.stripe.com/5kQbJ1gWV7iwcnjbKkbII03
# Verbose donation debug panel + [FilmLab donation debug] logs (any environment)
# NEXT_PUBLIC_FILM_LAB_DEBUG_DONATION=true
# Optional extra tiers (omit to show a single Stripe button)
NEXT_PUBLIC_FILM_LAB_STRIPE_SUPPORT_URL_9=
NEXT_PUBLIC_FILM_LAB_STRIPE_SUPPORT_URL_25=
NEXT_PUBLIC_FILM_LAB_BMC_URL=

# Film Lab donation — runtime (no NEXT_PUBLIC): read on the server on each request.
# Use on Vercel when you set URLs AFTER a deploy: avoids rebuilding just to embed NEXT_PUBLIC_*.
# If any FILM_LAB_* below is set, it overrides client-embedded empty NEXT_PUBLIC for /film-lab.
# Copy the same values as NEXT_PUBLIC_* above, or set only these on production.
FILM_LAB_STRIPE_SUPPORT_URL=https://buy.stripe.com/5kQbJ1gWV7iwcnjbKkbII03
FILM_LAB_STRIPE_SUPPORT_URL_9=
FILM_LAB_STRIPE_SUPPORT_URL_25=
FILM_LAB_BMC_URL=
# FILM_LAB_DONATION_UI=false
#
# Debug (no env var): /film-lab?filmLabDebugDonation=1 — panel + [FilmLab donation debug]. Or:
# NEXT_PUBLIC_FILM_LAB_DEBUG_DONATION=true — same without URL (also works in production builds).
# next dev always logs [FilmLab donation dev] on Film Lab mount + browser save (no env needed).

# Note: In development mode without this variable set,
# form submissions will be logged to the console and succeed.
