# =============================================================================
# Environment Variables - Contact Form
# =============================================================================

# Slack Webhook URL for contact form notifications
#
# Setup instructions:
# 1. Go to https://api.slack.com/apps
# 2. Create a new app or select an existing one
# 3. Navigate to "Incoming Webhooks" and activate them
# 4. Add a new webhook to your desired workspace/channel
# 5. Copy the webhook URL and paste it below
#
# Format: https://hooks.slack.com/services/TXXXXX/BXXXXX/XXXXXXXX
SLACK_WEBHOOK_URL=

# Meta Pixel ID for paid social attribution
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification code
# Get it from: https://search.google.com/search-console → Add Property → HTML tag method
# Copy only the content value (not the full meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Film Lab: show "Share" block (copy look URL, post to X). Default off for general users.
# NEXT_PUBLIC_FILM_LAB_SHARE_UI=true

# Film Lab: Smart look — UI はペンディング（非表示が既定）。再有効化手順: life #35
# NEXT_PUBLIC_FILM_LAB_SMART_LOOK_UI=true
# Server: mock (default) or openai for Vision JSON delta. Requires OPENAI_API_KEY when openai.
# FILM_LAB_SMART_LOOK_PROVIDER=mock
# OPENAI_API_KEY=
#
# Optional: Vercel KV for daily smart-look quota per supporter (UTC calendar day). If unset, no server-side daily cap.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# FILM_LAB_SMART_LOOK_RL_PER_DAY=50

# Film Lab: optional support (Stripe Payment Link per amount tier + optional Buy Me a Coffee).
# If every Stripe URL below is empty AND BMC is empty, donation UI is hidden.
# Use separate Payment Links per price (do not put multiple line_items on one link).
# Set NEXT_PUBLIC_FILM_LAB_DONATION_UI=false to force-disable even when URLs are set.
NEXT_PUBLIC_FILM_LAB_DONATION_UI=true
# Live Payment Link (USD $3 one-time) — public URL; copy to .env.local if needed
NEXT_PUBLIC_FILM_LAB_STRIPE_SUPPORT_URL=https://buy.stripe.com/5kQbJ1gWV7iwcnjbKkbII03
# Verbose donation debug panel + [FilmLab donation debug] logs (any environment)
# NEXT_PUBLIC_FILM_LAB_DEBUG_DONATION=true
# Optional extra tiers (omit to show a single Stripe button)
NEXT_PUBLIC_FILM_LAB_STRIPE_SUPPORT_URL_9=
NEXT_PUBLIC_FILM_LAB_STRIPE_SUPPORT_URL_25=
NEXT_PUBLIC_FILM_LAB_BMC_URL=

# Film Lab donation — runtime (no NEXT_PUBLIC): read on the server on each request.
# Use on Vercel when you set URLs AFTER a deploy: avoids rebuilding just to embed NEXT_PUBLIC_*.
# If any FILM_LAB_* below is set, it overrides client-embedded empty NEXT_PUBLIC for /film-lab.
# Copy the same values as NEXT_PUBLIC_* above, or set only these on production.
FILM_LAB_STRIPE_SUPPORT_URL=https://buy.stripe.com/5kQbJ1gWV7iwcnjbKkbII03
FILM_LAB_STRIPE_SUPPORT_URL_9=
FILM_LAB_STRIPE_SUPPORT_URL_25=
FILM_LAB_BMC_URL=
# FILM_LAB_DONATION_UI=false
#
# Debug (no env var): /film-lab?filmLabDebugDonation=1 — panel + [FilmLab donation debug]. Or:
# NEXT_PUBLIC_FILM_LAB_DEBUG_DONATION=true — same without URL (also works in production builds).
# next dev always logs [FilmLab donation dev] on Film Lab mount + browser save (no env needed).

# Film Lab Phase 2: Checkout Session verify + supporter Cookie（Thanks ページの POST /api/film-lab/donation/verify）。
# 32+ 文字のランダム文字列を `openssl rand -hex 32` などで生成。
# FILM_LAB_DONATION_SIGNING_SECRET=
# Stripe シークレット（標準名。Film Lab 専用なら FILM_LAB_STRIPE_SECRET_KEY でも可）。
# STRIPE_SECRET_KEY=
# Webhook（Stripe Dashboard → Webhooks → `https://<your-domain>/api/film-lab/donation/webhook`）。
# FILM_LAB_STRIPE_WEBHOOK_SECRET=

# Film Lab Desktop — 公開配布用 DMG の HTTPS 直 URL（/film-lab/download がこの URL へ redirect）。
# 置き場所の例: Vercel Blob など「誰でも GET できる」HTTPS。値が空のときは案内ページのみ表示。
# サーバ側の redirect のみなら FILM_LAB_* で十分（NEXT_PUBLIC は任意）。
# FILM_LAB_DESKTOP_DOWNLOAD_URL=https://…/filmtone-0.1.0-arm64.dmg
# NEXT_PUBLIC_FILM_LAB_DESKTOP_DOWNLOAD_URL=

# Note: In development mode without this variable set,
# form submissions will be logged to the console and succeed.

# =============================================================================
# Filmtone for DaVinci Resolve — product page (/filmtone/resolve)
# =============================================================================
# 別プロダクト（買い切り OFX プラグイン）の LP。既存 FILM_LAB 系とは別系統の env 名にしている。
# いずれも client 埋め込み（NEXT_PUBLIC_*）。空のときはページ側が安全にフォールバックする
# （購入 CTA → 「近日公開」の無効表示 / trial フォーム → 「一時的に利用不可」表示）。
#
# 重要（owner 向け）: /filmtone/resolve は静的生成（SSG）される。NEXT_PUBLIC_* は「ビルド時」に
# 埋め込まれるため、Vercel で値を設定した後は必ず再デプロイ（redeploy）すること。設定しただけでは
# 反映されず、購入 CTA は「近日公開」・trial は「利用不可」のまま。デプロイ後に値を差し込みたい場合は
# desktop-release-info.ts の FILM_LAB_DESKTOP_DOWNLOAD_URL のような server 側 runtime 変数へ切り替える
# 改修が必要（現状は task 指示どおり NEXT_PUBLIC_* 採用）。

# Cloudflare Turnstile の site key（trial 請求フォーム用・公開値だが未確定）。
# TODO(owner): 実際の site key を Vercel の環境変数に設定する。widget の action は
# サーバ（Worker）が要求する `filmtone_trial` 固定（コード側で固定済み）。site key は非公開情報ではないが、
# ここでは値を確定できないため空のまま。設定するまで trial フォームは無効表示になる。
NEXT_PUBLIC_FILMTONE_RESOLVE_TURNSTILE_SITE_KEY=

# Polar の checkout URL（購入 CTA のリンク先）。
# TODO(owner): 実際の Polar checkout URL を Vercel の環境変数に設定する。未設定の間、購入 CTA は
# 「近日公開」の無効状態になり、デッドリンクにはならない。このリポには Polar 連携は存在しない
# （既存の決済導線は Stripe の donation のみ）。receipt / post-purchase ページは Polar ダッシュボード側の設定。
NEXT_PUBLIC_FILMTONE_RESOLVE_POLAR_CHECKOUT_URL=

# 任意: trial 請求 endpoint の上書き（未設定なら本番 Worker の /trial を使う）。
# 既定値: https://filmtone-license-worker.chiba-4f9.workers.dev/trial
# NEXT_PUBLIC_FILMTONE_RESOLVE_TRIAL_ENDPOINT=

# 任意: 配布 pkg（署名・notarize・staple 済み）の HTTPS 直リンク。ファイル名は Filmtone-<version>.pkg。
# TODO(owner): 公開 pkg URL を設定する（現時点では実バージョン・配布先とも TBD）。
# NEXT_PUBLIC_FILMTONE_RESOLVE_PKG_DOWNLOAD_URL=
